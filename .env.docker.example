# Copiar a .env para personalizar docker compose:
#   cp .env.docker.example .env

# --- Oracle (contenedor db) ---
ORACLE_SYS_PASSWORD=Oracle123
ORACLE_USERNAME=curso
ORACLE_PASSWORD=curso123
ORACLE_HOST_PORT=1522

# URL JDBC para el backend en Docker.
# Con BD en contenedor (perfil db o stack):
ORACLE_URL=jdbc:oracle:thin:@//oracle:1521/XEPDB1
# Con BD en el host (sin contenedor db), descomentar:
# ORACLE_URL=jdbc:oracle:thin:@//host.docker.internal:1521/XEPDB1
# Con BD del contenedor accesible desde el host (puerto 1522):
# ORACLE_URL=jdbc:oracle:thin:@//host.docker.internal:1522/XEPDB1

# --- Backend ---
BACKEND_HOST_PORT=8080
JWT_SECRET=cambiar-este-secreto-en-produccion-minimo-32-caracteres
JWT_EXPIRATION_MS=86400000
SPRING_PROFILES_ACTIVE=local

# --- Frontend ---
FRONTEND_HOST_PORT=4200
# Backend en contenedor (default):
BACKEND_UPSTREAM=backend:8080
# Backend corriendo en el host (sin contenedor backend):
# BACKEND_UPSTREAM=host.docker.internal:8080
